<odoo>
  <record id="action_report_project_summary" model="ir.actions.report">
    <field name="name">Onboarding Summary</field>
    <field name="model">shift.onboarding.project</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">shift_onboarding.report_project_summary</field>
    <field name="print_report_name">'Onboarding - %s' % object.name</field>
    <field name="binding_model_id" ref="model_shift_onboarding_project"/>
    <field name="binding_type">report</field>
  </record>

  <template id="report_project_summary">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Onboarding Summary</h2>

            <div class="mt-3">
              <p><strong>Client:</strong> <span t-out="o.partner_id.name"/></p>
              <p><strong>Project:</strong> <span t-out="o.name"/></p>
              <p><strong>Responsible:</strong> <span t-out="o.user_id.name"/></p>
              <p><strong>Start date:</strong> <span t-field="o.date_start"/></p>
              <p><strong>Deadline:</strong> <span t-field="o.deadline"/></p>
              <p><strong>Progress:</strong> <span t-out="'%d' % o.progress"/>%</p>
            </div>

            <h4 class="mt-4">Tasks</h4>
            <t t-if="o.task_ids">
              <table class="table table-sm">
                <thead>
                  <tr>
                    <th>Task</th>
                    <th>Deadline</th>
                    <th>Assignee</th>
                    <th>Done</th>
                  </tr>
                </thead>
                <tbody>
                  <tr t-foreach="o.task_ids" t-as="task">
                    <td><span t-out="task.name"/></td>
                    <td><span t-field="task.deadline"/></td>
                    <td><span t-out="task.assignee_id.name"/></td>
                    <td><span t-out="'Yes' if task.done else 'No'"/></td>
                  </tr>
                </tbody>
              </table>
            </t>
            <p t-else="">No tasks yet.</p>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>