<odoo>
  <record id="shift_task_reassign_wizard_form" model="ir.ui.view">
    <field name="name">shift.onboarding.task.reassign.wizard.form</field>
    <field name="model">shift.onboarding.task.reassign.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="assignee_id"/>
          <field name="task_ids" widget="many2many_tags" readonly="1"/>
        </group>
        <footer>
          <button name="action_reassign" string="Reassign" type="object"
                  class="btn-primary" data-hotkey="q"/>
          <button string="Cancel" class="btn-secondary" special="cancel"
                  data-hotkey="x"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="shift_task_reassign_wizard_action" model="ir.actions.act_window">
    <field name="name">Reassign Tasks</field>
    <field name="res_model">shift.onboarding.task.reassign.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="model_shift_onboarding_task"/>
    <field name="binding_view_types">list</field>
  </record>
</odoo>