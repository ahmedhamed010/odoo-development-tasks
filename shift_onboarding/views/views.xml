<odoo>
  <!-- List view -->
  <record id="shift_view_list" model="ir.ui.view">
    <field name="name">shift list</field>
    <field name="model">shift.onboarding.project</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="partner_id"/>
        <field name="user_id"/>
        <field name="date_start"/>
        <field name="deadline"/>
        <field name="state"/>
        <field name="notes"/>
      </list>
    </field>
  </record>

  <!-- Form view -->
  <record id="shift_view_form" model="ir.ui.view">
    <field name="name">shift form</field>
    <field name="model">shift.onboarding.project</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">
            <button name="action_view_tasks" type="object"
                    class="oe_stat_button" icon="fa-tasks">
              <field name="task_count" widget="statinfo" string="Tasks"/>
            </button>
          </div>
          <group>
            <group string="General Info">
              <field name="name"/>
              <field name="partner_id"/>
              <field name="user_id"/>
            </group>
            <group string="Date Info">
              <field name="date_start"/>
              <field name="deadline"/>
              <field name="progress" widget="progressbar"/>
            </group>
          </group>
          <notebook>
            <page string="Tasks">
              <field name="task_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="deadline"/>
                  <field name="assignee_id"/>
                  <field name="done"/>
                </list>
              </field>
            </page>
            <page string="Notes">
              <field name="notes"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
        <!-- <div class="oe_chatter">
          <field name="message_follower_ids"/>
          <field name="activity_ids"/>
          <field name="message_ids"/>
        </div> -->
      </form>
    </field>
  </record>

  <!-- Search View -->
    <record id="shift_view_search" model="ir.ui.view">
        <field name="name">shift search</field>
        <field name="model">shift.onboarding.project</field>
        <field name="arch" type="xml">
            <search>
                
                <field name="name"/>
                <field name="partner_id"/>

                    <filter name="is_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="is_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                    <filter name="is_done" string="Done" domain="[('state', '=', 'done')]"/>
                    <filter name="is_cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>

                    <group>
                      <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    </group>
                
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="shift_action" model="ir.actions.act_window">
        <field name="name">shift</field>
        <field name="res_model">shift.onboarding.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- menuitem -->
    <menuitem
        id="shift_menu"
        name="Shift Onboarding"
    />
    <menuitem
        id="shift_menu_item"
        name="Shift"
        parent="shift_menu"
        action="shift_action"
    />

</odoo>