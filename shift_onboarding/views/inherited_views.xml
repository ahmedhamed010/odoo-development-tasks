<odoo>
  <!-- Product: "Requires Onboarding" checkbox -->
  <record id="shift_product_template_form_inherit" model="ir.ui.view">
    <field name="name">product.template.form.shift.onboarding</field>
    <field name="model">product.template</field>
    <field name="inherit_id" ref="product.product_template_form_view"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='categ_id']" position="after">
        <field name="requires_onboarding"/>
      </xpath>
    </field>
  </record>

  <!-- Customer: smart button with onboarding projects -->
  <record id="shift_partner_form_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.shift.onboarding</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <div name="button_box" position="inside">
        <button name="action_view_onboarding_projects" type="object"
                class="oe_stat_button" icon="fa-tasks">
          <field name="onboarding_project_count" widget="statinfo"
                 string="Onboarding"/>
        </button>
      </div>
    </field>
  </record>
</odoo>